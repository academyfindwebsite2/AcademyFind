// ==========================================
// Custom Real-time Analytics System
// ==========================================

model VisitorSession {
  id          String   @id @default(cuid())
  cookieId    String   @unique
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress   String?
  city        String?
  country     String?
  device      String?
  browser     String?
  os          String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      VisitorEvent[]
}

model VisitorEvent {
  id          String   @id @default(cuid())
  sessionId   String
  session     VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType   String   // e.g., "PAGE_VIEW", "CLICK", "SEARCH"
  pageUrl     String
  details     String?  // Extra info like search query or button name
  createdAt   DateTime @default(now())
}

model Advertisement {
  id                String   @id @default(cuid())
  userId            String
  title             String
  description       String?
  linkUrl           String?
  images            String[] // Minimum 1 image required, up to 4
  status            AdvertisementStatus @default(PENDING) // PENDING, APPROVED, REJECTED, EXPIRED
  visibility        AdvertisementVisibility @default(VISIBLE) // VISIBLE, HIDDEN, DELETED
  pricePaid         Int      @default(199)
  paymentScreenshot String?
  utrNumber         String?
  
  isRenewalRequest  Boolean  @default(false)
  editRequestData   Json?
  
  startDate         DateTime?
  expiryDate        DateTime? // Default 30 days from approval date
  
  views             Int @default(0) // Total views (logged in + not logged in)
  clicks            Int @default(0) // Total clicks (logged in + not logged in)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analytics         AdvertisementAnalytic[]
  
  @@index([userId])
  @@index([status])
  @@map("advertisement")
}

model AdvertisementAnalytic {
  id              String   @id @default(cuid())
  advertisementId String
  actionType      String   // "VIEW" or "CLICK"
  pageUrl         String?  // The page where the ad was viewed/clicked
  userId          String?  // If the viewer was logged in
  count           Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  
  @@index([advertisementId])
  @@map("advertisement_analytic")
}

enum AdvertisementStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AdvertisementVisibility {
  VISIBLE
  HIDDEN
  DELETED
}

