  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("blog_bookmark")
}

model BlogAuthorFollower {
  id String @id @default(cuid())

  authorProfileId String

  userId String

  createdAt DateTime @default(now())

  authorProfile BlogAuthorProfile @relation(fields: [authorProfileId], references: [id], onDelete: Cascade)

  user User @relation("UserFollowedAuthors", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([authorProfileId, userId])
  @@index([authorProfileId])
  @@index([userId])
  @@map("blog_author_follower")
}

model BlogSubscriber {
  id String @id @default(cuid())

  email String @unique

  isVerified Boolean @default(false)

  isActive Boolean @default(true)

  verificationToken String? @unique

  unsubscribeToken String? @unique

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([isActive])
  @@index([createdAt])
  @@map("blog_subscriber")
}

model BlogReport {
  id String @id @default(cuid())

  postId String

  userId String

  reason ReportReason

  message String? @db.Text

  status ReportStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

