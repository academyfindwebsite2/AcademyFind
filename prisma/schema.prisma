generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id @default(cuid())
  name                     String?
  username                 String                    @unique
  email                    String                    @unique
  phone                    String?
  passwordHash             String?
  image                    String?
  coverImage               String?
  role                     Role                      @default(USER)
  isActive                 Boolean                   @default(true)
  emailVerified            Boolean                   @default(false)
  onboardingCompleted      Boolean                   @default(false)
  lastLoginAt              DateTime?
  pushToken                String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  canAddInstitute          Boolean                   @default(true)
  canWriteBlogs            Boolean                   @default(true)
  managedInstitutes        InstituteManager[]
  facebookUrl              String?
  instagramUrl             String?
  telegramUrl              String?
  twitterUrl               String?
  youtubeUrl               String?
  linkedinUrl              String?
  whatsappUrl              String?
  reviews                  Review[]
  accounts                 Account[]
  adminNotifications       AdminNotification[]
  communityAnswers         CommunityAnswer[]
  communityQuestions       CommunityQuestion[]
  claims                   InstituteClaim[]
  instituteRequests        InstituteRequest[]
  salesAssignments         SalesAssignment[]         @relation("SalesAssignments")
  salesCategoryAssignments SalesCategoryAssignment[] @relation("SalesCategoryAssignments")
  salesAreaAssignments     SalesAreaAssignment[]     @relation("SalesAreaAssignments")
  salesEnquiryAssignments  InstituteEnquiry[]        @relation("SalesEnquiryAssignments")
  salesRequests            SalesAssignmentRequest[]  @relation("SalesAssignmentRequests")
  reviewedSalesRequests    SalesAssignmentRequest[]  @relation("ReviewedSalesRequests")
  ismAssignments           InstituteSalesManagerAssignment[] @relation("IsmAssignments")
  ismAssignedBy            InstituteSalesManagerAssignment[] @relation("IsmAssignedBy")
  ismLeadAssignments       InstituteEnquiry[]        @relation("IsmEnquiryAssignments")
  ismActivities            IsmLeadActivity[]         @relation("IsmActivities")
  ismAdmissions            AdmissionRecord[]         @relation("IsmAdmissions")
  ismInvitesReceived       IsmInviteRequest[]        @relation("IsmInvites")
  ismInvitesSent           IsmInviteRequest[]        @relation("IsmInvitesSent")
  sessions                 Session[]
  payments                 SubscriptionPayment[]
  instituteUnlocks         InstituteUnlock[]
  compareLists             UserCompareList[]
  viewHistory              UserHistory[]
  shortlisted              UserShortlist[]
  distributionLogs         LeadDistributionLog[]     @relation("AdminDistributionLogs")
  blogAuthorProfile        BlogAuthorProfile?
  blogComments             BlogComment[]
  blogReactions            BlogReaction[]
  blogViews                BlogView[]                @relation("UserBlogViews")
  blogBookmarks            BlogBookmark[]            @relation("UserBookmarks")
  followedAuthors          BlogAuthorFollower[]      @relation("UserFollowedAuthors")
  reviewedPosts            BlogPost[]                @relation("PostReviewer")
  publishedPosts           BlogPost[]                @relation("PostPublisher")
  editedPosts              BlogPost[]                @relation("PostEditor")
  blogRevisions            BlogRevision[]            @relation("RevisionAuthor")
  reviewReplies            ReviewReply[]
  visitorSessions          VisitorSession[]
  blogReports              BlogReport[]
  resolvedBlogReports      BlogReport[]              @relation("ResolvedBlogReports")
  studentProfile           StudentProfile?
  teacherProfile           TeacherProfile?
  memberships              InstituteMembership[]
  chatSettings             ChatSettings?
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  contactMessages          ContactMessage[]          @relation("UserContactMessages")
  messageReads             MessageRead[]
  messageReactions         MessageReaction[]
  messageReports           MessageReport[]           @relation("Reporter")
  resolvedMessageReports   MessageReport[]           @relation("Resolver")
  blockedUsers             UserBlock[]               @relation("UserBlocks")
  blockedByUsers           UserBlock[]               @relation("BlockedUsers")
  createdConversations     Conversation[]
  notifications            UserNotification[]
  wallet                   UserWallet?
  reputation               UserReputation?
  preferences              UserPreference?
  allowDms                 Boolean                   @default(true)
  educations               UserEducation[]
  experiences              UserExperience[]
  achievements             UserAchievement[]
  skills                   UserSkill[]
  instituteVisits          InstituteVisit[]
  isVisible                Boolean                   @default(true)
  advertisements           Advertisement[]

  @@map("user")
}

model UserWallet {
  id             String              @id @default(cuid())
  userId         String              @unique
  balance        Int                 @default(0)
  lifetimeEarned Int                 @default(0)
  lifetimeSpent  Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   WalletTransaction[]

  @@map("user_wallet")
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionSource {
  DAILY_LOGIN
  PROFILE_COMPLETION
  COMPLETE_PROFILE
  REVIEW
  WRITE_REVIEW
  REVIEW_LIKE
  DO_LIKE_REPLY_REVIEW
  REVIEW_LIKE_REPLY
  REFERRAL
  PURCHASE
  AI_CHAT
  DM_BOOST
  COURSE_PURCHASE
  ADMIN
  REFUND
  BONUS
  SIGN_UP
  BLOG_POST
  COMMUNITY_QUESTION
  COMMUNITY_ANSWER
  INSTITUTE_MEMBERSHIP
  CONTENT_REPORT
  SEE_CONTACT_BASIC_INSTITUTE
  MESSAGE_OTHER_USER
  RESUME_REVIEW
  INTERVIEW_GUIDANCE
  COLLEGE_COUNSELLING
  CARRIER_COUNSELLING
  UPSC_STRATEGY_SESSION
  SEE_STUDENT_PROFILE_BASIC
  SEE_TEACHER_PROFILE_BASIC
  VERIFY_MOBILE
  SEE_COMMUNITY_BASIC_INSTITUTE
}

model WalletTransaction {
  id String @id @default(cuid())

  walletId String

  type WalletTransactionType

  source WalletTransactionSource

  amount Int

  balanceAfter Int

  description String?

  referenceId String?

  createdAt DateTime @default(now())

  wallet UserWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([source])
  @@map("wallet_transaction")
}

model UserReputation {
  id String @id @default(cuid())

  userId String @unique

  score Int @default(0)

  teacherScore Int @default(0)

  studentScore Int @default(0)

  managerScore Int @default(0)

  lifetimeEarned Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  logs ReputationLog[]

  @@map("user_reputation")
}

enum ReputationSource {
  PROFILE_COMPLETED

  VERIFIED_PROFILE

  REVIEW_POSTED

  REVIEW_HELPFUL

  STUDENT_VERIFIED

  TEACHER_VERIFIED

  MANAGER_VERIFIED

  REFERRAL

  ANSWER_HELPFUL

  COMMUNITY_CONTRIBUTION

  ADMIN
}

model UserPreference {
  id                  String                  @id @default(cuid())
  userId              String                  @unique
  emailOnDm           Boolean                 @default(true)
  emailOnNews         Boolean                 @default(true)
  emailOnUpdates      Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredCities     UserPreferenceCity[]
  preferredCategories UserPreferredCategory[]
  completedAt         DateTime?

  @@map("user_preference")
}

model UserPreferredCategory {
  id           String         @id @default(cuid())
  preferenceId String
  categoryId   String
  priority     Int            @default(0)
  preference   UserPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([preferenceId, categoryId])
  @@index([categoryId])
  @@index([preferenceId])
  @@map("user_preferred_category")
}

model UserPreferenceCity {
  id           String         @id @default(cuid())
  preferenceId String
  cityId       String
  priority     Int            @default(0)
  preference   UserPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  city         City           @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([preferenceId, cityId])
  @@index([cityId])
  @@index([preferenceId])
  @@map("user_preference_city")
}

model ReputationLog {
  id           String           @id @default(cuid())
  reputationId String
  source       ReputationSource
  points       Int
  description  String?
  referenceId  String?
  createdAt    DateTime         @default(now())
  reputation   UserReputation   @relation(fields: [reputationId], references: [id], onDelete: Cascade)

  @@index([reputationId])
  @@index([source])
  @@map("reputation_log")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Institute {
  id                  String                     @id @default(cuid())
  providerType        ProviderType               @default(INSTITUTE)
  name                String
  slug                String
  description         String?
  phone               String?
  email               String?
  website             String?
  address             String
  latitude            Float?
  longitude           Float?
  logo                String?
  coverImage          String?
  googlePlaceId       String?                    @unique
  googleRating        Float?
  googleReviewCount   Int?
  cityId              String
  isVerified          Boolean                    @default(false)
  isFeatured          Boolean                    @default(false)
  isActive            Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  crmIntegrations     CRMIntegration[]
  inboundLeadIntegrations InboundLeadIntegration[]
  inboundLeads        InboundLead[]
  imageUrl            String?
  averageRating       Float?                     @default(0)
  reviewCount         Int                        @default(0)
  googleMapsUrl       String?
  placeTypes          String[]
  gallery             String[]
  subscriptionPlan    SubscriptionPlan           @default(BASIC)
  planWeight          Int                        @default(1)
  youtubeVideos       String[]
  classroomImages     String[]
  feeInfo             String?
  planExpiresAt       DateTime?
  facebookUrl         String?
  instagramUrl        String?
  telegramUrl         String?
  twitterUrl          String?
  youtubeUrl          String?
  linkedinUrl         String?
  whatsappUrl         String?
  isPublished         Boolean                    @default(true)
  mode                InstituteMode              @default(OFFLINE)
  viewCount           Int                        @default(0)
  affiliations        String[]                   @default([])
  awards              String[]                   @default([])
  brochureUrl         String?
  compareCount        Int                        @default(0)
  cons                String[]                   @default([])
  establishedYear     Int?
  feeMax              Int?
  feeMin              Int?
  hasCertification    Boolean                    @default(false)
  hasDemoClasses      Boolean                    @default(false)
  hasHostelFacility   Boolean                    @default(false)
  hasOnlineClasses    Boolean                    @default(false)
  hasScholarship      Boolean                    @default(false)
  mediumOfInstruction String[]                   @default(["English", "Hindi"])
  metaDescription     String?
  metaTitle           String?
  metaKeywords        String?
  pros                String[]                   @default([])
  refundPolicy        String?
  totalBranches       Int?
  totalStudents       Int?
  city                City                       @relation(fields: [cityId], references: [id])
  categories          InstituteCategory[]
  managers            InstituteManager[]
  reviews             Review[]
  communityQuestions  CommunityQuestion[]
  compareListItems    CompareListInstitute[]
  achievements        InstituteAchievement[]
  batches             InstituteBatch[]
  claims              InstituteClaim[]
  comparisonsAsFirst  InstituteComparisonCache[] @relation("ComparisonAsFirst")
  comparisonsAsSecond InstituteComparisonCache[] @relation("ComparisonAsSecond")
  dailyViews          InstituteDailyView[]
  visits              InstituteVisit[]
  enquiries           InstituteEnquiry[]
  facilities          InstituteFacility[]
  faqs                InstituteFAQ[]
  highlightStats      InstituteHighlightStat[]
  operatingHours      InstituteOperatingHour[]
  instituteRequest    InstituteRequest?
  notablepersons      NotablePersons[]
  salesAssignments    SalesAssignment?
  salesRequests       SalesAssignmentRequest[]
  payments            SubscriptionPayment[]
  unlocks             InstituteUnlock[]
  viewHistory         UserHistory[]
  shortlistedBy       UserShortlist[]
  blogPosts           BlogPost[]                 @relation("InstituteBlogPosts")
  memberships         InstituteMembership[]
  ismAssignments      InstituteSalesManagerAssignment[]
  admissionRecords    AdmissionRecord[]
  ismInviteRequests   IsmInviteRequest[]

  studentRecords StudentInstituteRecord[]
  teacherRecords TeacherInstituteRecord[]

  conversations Conversation[]
  communicationTemplates InstituteCommunicationTemplate[]

  @@index([cityId])
  @@index([slug])
}

model City {
  id               String                @id @default(cuid())
  name             String
  slug             String                @unique
  state            String
  country          String                @default("India")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  bannerImage      String?
  description      String?
  latitude         Float?
  longitude        Float?
  metaDescription  String?
  metaTitle        String?
  population       Int?
  institutes       Institute[]
  categoryContents CategoryCityContent[]
  preferredBy      UserPreferenceCity[]

  @@index([state])
}

model Category {
  id                       String                    @id @default(cuid())
  name                     String
  slug                     String                    @unique
  parentId                 String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  isActive                 Boolean                   @default(true)
  level                    Int                       @default(0)
  bannerImage              String?
  description              String?
  icon                     String?
  metaDescription          String?
  metaTitle                String?
  shortDescription         String?
  parent                   Category?                 @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children                 Category[]                @relation("CategoryHierarchy")
  institutes               InstituteCategory[]
  cityContents             CategoryCityContent[]
  salesCategoryAssignments SalesCategoryAssignment[]
  salesRequests            SalesAssignmentRequest[]

  preferredBy UserPreferredCategory[]

  @@index([parentId])
}

model CategoryCityContent {
  id               String   @id @default(cuid())
  categoryId       String
  cityId           String
  introContent     String?
  whyChooseContent String?
  metaTitle        String?
  metaDescription  String?
  h1Override       String?
  updatedAt        DateTime @updatedAt
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  city             City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([categoryId, cityId])
  @@index([categoryId])
  @@index([cityId])
  @@map("category_city_content")
}

model InstituteCategory {
  instituteId String
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@id([instituteId, categoryId])
  @@index([categoryId])
}

model InstituteManager {
  userId      String
  instituteId String
  createdAt   DateTime  @default(now())
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, instituteId])
  @@index([instituteId])
}

model Review {
  id          String       @id @default(cuid())
  rating      Int
  comment     String?
  userId      String
  instituteId String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  status      ReviewStatus @default(PENDING)
  institute   Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     ReviewReply[]

  @@unique([userId, instituteId])
  @@index([userId])
  @@index([instituteId])
}

model ReviewReply {
  id        String       @id @default(cuid())
  reviewId  String
  userId    String
  content   String       @db.Text
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([userId])
  @@map("review_reply")
}

model InstituteClaim {
  id          String    @id @default(cuid())
  instituteId String
  userId      String
  fullName    String
  email       String
  phone       String
  role        String
  message     String?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([userId])
  @@index([status])
  @@map("institute_claim")
}

model UserShortlist {
  userId      String
  instituteId String
  createdAt   DateTime  @default(now())
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, instituteId])
  @@map("user_shortlist")
}

model UserHistory {
  id          String    @id @default(cuid())
  userId      String
  instituteId String
  viewedAt    DateTime  @default(now()) @updatedAt
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, instituteId])
  @@index([userId])
  @@map("user_history")
}

model InstituteUnlock {
  id          String    @id @default(cuid())
  userId      String
  instituteId String
  unlockType  String    // "PHONE", "WEBSITE", "EMAIL", "SOCIAL", "COMMUNITY"
  coinsSpent  Int       @default(1)
  description String?
  createdAt   DateTime  @default(now())

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([userId])
  @@index([createdAt])
  @@map("institute_unlock")
}

model InstituteEnquiry {
  id                     String                @id @default(cuid())
  instituteId            String
  name                   String
  phone                  String
  email                  String?
  message                String?
  status                 String                @default("NEW")
  userContactStatus       String                @default("NEW")
  isForwarded            Boolean               @default(false)
  adminNote              String?               @db.Text
  salesManagerNote       String?               @db.Text
  assignedSalesManagerId String?
  assignedSalesManager   User?                 @relation("SalesEnquiryAssignments", fields: [assignedSalesManagerId], references: [id], onDelete: SetNull)
  assignedIsmId          String?
  assignedIsm            User?                 @relation("IsmEnquiryAssignments", fields: [assignedIsmId], references: [id], onDelete: SetNull)
  ismNote                String?               @db.Text
  nextFollowUp           DateTime?
  followUpNote           String?               @db.Text
  convertedToAdmission   Boolean               @default(false)
  lastUpdatedByRole      String?
  lastUpdatedByName      String?
  parentId               String?
  course                 String?
  batch                  String?
  tags                   String[]              @default([])
  source                 String                @default("ACADEMYFIND")
  sourceDetails          Json?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  institute              Institute             @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  distributionLogs       LeadDistributionLog[] @relation("DistributionLogs")
  statusHistory          EnquiryStatusHistory[]
  comments               EnquiryComment[]
  ismActivities          IsmLeadActivity[]
  admissionRecord        AdmissionRecord?

  @@index([instituteId])
  @@index([assignedSalesManagerId])
  @@index([assignedIsmId])
  @@map("institute_enquiry")
}

model TeacherProfile {
  id               String                   @id @default(cuid())
  userId           String                   @unique
  headline         String?
  bio              String?                  @db.Text
  qualification    String?
  experience       String?
  subjects         String[]                 @default([])
  languages        String[]                 @default([])
  isVisible        Boolean                  @default(true)
  isVerified       Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @default(now()) @updatedAt
  user             User?                    @relation(fields: [userId], references: [id])
  instituteRecords TeacherInstituteRecord[]

  @@map("teacher_profile")
}

model StudentProfile {
  id               String                   @id @default(cuid())
  userId           String                   @unique
  headline         String?
  bio              String?                  @db.Text
  targetExam       String?
  currentClass     String?
  isVisible        Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instituteRecords StudentInstituteRecord[]

  @@map("student_profile")
}

model InstituteMembership {
  id            String                  @id @default(cuid())
  userId        String
  instituteId   String
  role          InstituteMemberRole
  status        MembershipStatus        @default(PENDING)
  joinedAt      DateTime?
  leftAt        DateTime?
  isActive      Boolean                 @default(true)
  joinedViaAcademyFind Boolean          @default(false)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute     Institute               @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  studentRecord StudentInstituteRecord?
  teacherRecord TeacherInstituteRecord?

  @@unique([userId, instituteId, role])
  @@index([instituteId])
  @@index([userId])
  @@map("institute_membership")
}

model StudentInstituteRecord {
  id               String              @id @default(cuid())
  membershipId     String              @unique
  studentProfileId String
  instituteId      String
  courseName       String?
  batchYear        Int?
  passoutYear      Int?
  rollNumber       String?
  bio              String?             @db.Text
  isVerified       Boolean             @default(false)
  isVisible        Boolean             @default(true)
  allowMessaging   Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  membership       InstituteMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  institute        Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batchMemberships BatchStudent[]

  @@unique([studentProfileId, instituteId])
  @@index([instituteId])
  @@map("student_institute_record")
}

model TeacherInstituteRecord {
  id               String              @id @default(cuid())
  membershipId     String              @unique
  teacherProfileId String
  instituteId      String
  designation      String?
  department       String?
  teachingSubjects String[]            @default([])
  joinedOn         DateTime?
  bio              String?             @db.Text
  isFeatured       Boolean             @default(false)
  isVerified       Boolean             @default(false)
  isVisible        Boolean             @default(true)
  displayOrder     Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  membership       InstituteMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile      @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  institute        Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batchMemberships BatchTeacher[]

  @@unique([teacherProfileId, instituteId])
  @@index([instituteId])
  @@map("teacher_institute_record")
}

enum InstituteMemberRole {
  STUDENT
  TEACHER
  MANAGER
  ADMIN
  SALES_MANAGER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  ALUMNI
  REMOVED
  REJECTED
}

enum ConversationType {
  DIRECT
  INSTITUTE
  BATCH
  GROUP
  AI
}

model Conversation {
  id             String                    @id @default(cuid())
  type           ConversationType
  dmKey          String?                   @unique
  instituteId    String?
  batchId        String?
  channelType    ChannelType?
  title          String?
  imageUrl       String?
  description    String?
  createdById    String?
  visibility     ConversationVisibility    @default(PRIVATE)
  memberCount    Int                       @default(0)
  lastMessageId  String?
  lastMessageAt  DateTime?
  lastActivityAt DateTime?
  isReadOnly     Boolean                   @default(false)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
