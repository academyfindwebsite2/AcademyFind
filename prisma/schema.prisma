  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([resolvedById])
  @@map("blog_report")
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  tag BlogTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("blog_post_tag")
}

model BlogComment {
  id String @id @default(cuid())

  postId String

  userId String

  parentId String?

  content String @db.Text

  status CommentStatus @default(PENDING)

  isEdited Boolean @default(false)

  editedAt DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //------------------------------------
  // Relations
  //------------------------------------

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  parent BlogComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict)

  replies BlogComment[] @relation("CommentReplies")

  //------------------------------------
  // Indexes
  //------------------------------------

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@index([status])
  @@index([createdAt])
  @@index([postId, status])
  @@map("blog_comment")
}

model BlogReaction {
  id String @id @default(cuid())

  postId String

  userId String

  type ReactionType @default(LIKE)

  createdAt DateTime @default(now())

  //------------------------------------
  // Relations
  //------------------------------------

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  //------------------------------------
  // Constraints
  //------------------------------------

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([type])
  @@map("blog_reaction")
}

model BlogFAQ {
  id String @id @default(cuid())

  postId String

  question String

